# Base URL of constroman-api
VITE_API_URL=http://localhost:8000

# Supabase project (Project settings > API). Same project as the API's SUPABASE_URL.
# Enable the Email provider and keep "Confirm email" ON (Authentication > Providers > Email), so an
# unverified address cannot claim an invitation. Add this app's origin (e.g. http://localhost:5173)
# to Authentication > URL Configuration > Redirect URLs for the confirmation link.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
